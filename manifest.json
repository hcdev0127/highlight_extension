{
  "manifest_version": 3,
  "name": "Job Keyword Highlighter",
  "version": "1.0",
  "description": "Highlights remote and onsite job keywords on webpages.",
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/*",
        "https://*.reed.co.uk/*",
        "<all_urls>"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}