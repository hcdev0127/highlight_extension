{
  "manifest_version": 3,
  "name": "Job Keyword Highlighter",
  "version": "1.0",
  "description": "Highlights remote and onsite job keywords on webpages.",
  "icons":{
    "32": "icon.png"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "Highlight job keywords"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}